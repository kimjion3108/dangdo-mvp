# Server only. Never put these values in VITE_* variables or commit actual keys.
NODE_ENV=production
PORT=3000
DATABASE_PATH=data/dangdo.sqlite
STATIC_DIR=dist
FRONTEND_URL=https://kimjion3108.github.io/dangdo-mvp/
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=https://YOUR_API_DOMAIN/api/auth/callback
SEOUL_SUBWAY_KEY=
SEOUL_CITY_KEY=

# Exact city API area names with verified geographic bounding boxes [west,south,east,north].
SEOUL_CITY_AREAS_JSON=[]

# Normalized, licensed KoROAD polygon export with verified coverageBounds and source metadata.
# Generate using scripts/import_orbit_hotspots.py; keep data server-side.
ORBIT_HOTSPOTS_FILE=
